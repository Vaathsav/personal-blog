---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects | Sri Vaathsav">
	<section class="page-hero">
		<p class="eyebrow">Projects</p>
		<h1>Selected work and experiments.</h1>
		<p class="tagline">
			This space will grow as I build and share more projects, from backend systems to cloud experiments and developer tools.
		</p>
	</section>

	<section class="content-section">
		<div class="card-grid">
			<article class="card">
				<h3>Personal Website</h3>
				<p>A minimalist site built with Astro to share ideas, projects, and notes in a clean, maintainable format.</p>
			</article>
			<article class="card">
				<h3>Java Backend Toolkit</h3>
				<p>Practical utilities and notes for exploring backend architecture, APIs, and deployment patterns.</p>
			</article>
		</div>
	</section>
</BaseLayout>
