---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const createHref = (path) => `${base}${path.replace(/^\//, '')}`;
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const latestPosts = posts.slice(0, 3);
---

<BaseLayout title="Blog | Sri Vaathsav">
	<section class="blog-intro">
		<p class="eyebrow">Blog</p>
		<h1>Latest Articles</h1>
		<p class="tagline">Notes, ideas, and practical lessons from building and learning.</p>
	</section>

	<section class="content-section blog-list-section">
		<div class="card-grid blog-grid">
			{latestPosts.map((post) => (
				<a class="card blog-card" href={createHref(`blog/${post.id}`)}>
					<p class="card-meta">
						{post.data.publishDate.toLocaleDateString('en', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</p>
					<h3>{post.data.title}</h3>
					<p>{post.data.description}</p>
					{post.data.tags.length > 0 && (
						<div class="tag-list">
							{post.data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)}
					<div class="card-footer">
						<span>Read Article</span>
						<span aria-hidden="true">→</span>
					</div>
				</a>
			))}
		</div>

		<a class="browse-link" href={createHref('blog')}>Browse All Articles →</a>
	</section>
</BaseLayout>
