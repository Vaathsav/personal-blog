---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Sri Vaathsav">
	<section class="page-hero">
		<p class="eyebrow">Contact</p>
		<h1>Let’s connect.</h1>
		<p class="tagline">
			If you’d like to talk about software, cloud, Java, or a project idea, feel free to reach out.
		</p>
	</section>

	<section class="content-section">
		<div class="card-grid single-column">
			<article class="card">
				<h3>Get in touch</h3>
				<p>Questions, collaborations, or just a hello — this contact page will soon include your preferred contact details.</p>
			</article>
		</div>
	</section>
</BaseLayout>
