---
const base = import.meta.env.BASE_URL;
const createHref = (path) => `${base}${path.replace(/^\//, '')}`;

const pathname = Astro.url.pathname.replace(new RegExp(`^${base.replace(/\/$/, '')}`), '') || '/';
const normalizedPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const navItems = [
	{ label: 'Home', path: '/' },
	{ label: 'Blog', path: '/blog' },
	{ label: 'Projects', path: '/projects' },
	{ label: 'About', path: '/about' },
	{ label: 'Contact', path: '/contact' },
];
---

<header class="site-header">
	<a class="brand" href={base}>Sri Vaathsav</a>
	<nav class="nav-links" aria-label="Primary navigation">
		{navItems.map((item) => {
			const isActive = normalizedPath === item.path;
			return (
				<a href={createHref(item.path)} aria-current={isActive ? 'page' : undefined}>
					{item.label}
				</a>
			);
		})}
	</nav>
</header>
